# ReviewLens AI environment template
#
# Copy this file to .env.local and fill in values locally:
#   macOS/Linux:  cp .env.example .env.local
#   Windows:      copy .env.example .env.local
#
# .env.local is ignored by Git. Never commit real keys to this file or any other.
# Nothing here is required yet: the S1-005 starter app runs with no environment variables.
#
# S1-008 (Configure Environment and Secret Management) owns the final variable list,
# descriptions, and startup validation. These entries reserve the Supabase names used by S1-009.

# Supabase project URL. Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Public by Supabase design; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# S1-023 server-only ingestion mutations. Never expose this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Keep paid provider access off until team review, S1-019 integration and storage approval.
INGESTION_ENABLED=false
OUTSCRAPER_API_KEY=
PROVIDER_REVIEW_STORAGE_APPROVED=false
# Reference to the team's recorded provider AND source storage-terms approval; no credentials.
PROVIDER_REVIEW_STORAGE_APPROVAL_REFERENCE=
# S1-023 server-generated recovery callbacks. Keep the secret stable for all outstanding jobs.
# Canonical, publicly reachable HTTPS origin, with no path/query or credentials.
INGESTION_CALLBACK_ORIGIN=
# Generate at least 32 random bytes. Never expose/log this secret or signed callback URLs.
INGESTION_CALLBACK_SECRET=

# S2-011 review Q&A (server-only). Keep paid model calls off until team review and the
# S2-004 evaluation run; any value other than exactly "true" disables Q&A before any call.
QA_ENABLED=false
# OpenAI API key. Never expose it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# OpenAI model ID for Q&A (team decision). Required when QA_ENABLED=true; there is no default.
OPENAI_QA_MODEL=
