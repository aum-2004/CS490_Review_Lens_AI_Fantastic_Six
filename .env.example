# ReviewLens AI environment template
#
# Copy this file to .env.local and fill in values locally:
#   macOS/Linux:  cp .env.example .env.local
#   Windows:      copy .env.example .env.local
#
# .env.local is ignored by Git. Never commit real keys to this file or any other.
# Nothing here is required yet: the S1-005 starter app runs with no environment variables.
#
# S1-008 (Configure Environment and Secret Management) owns the final variable list,
# descriptions, and startup validation. These entries reserve the Supabase names used by S1-009.

# Supabase project URL. Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Public by Supabase design; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
